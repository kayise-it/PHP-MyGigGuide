APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Mail admin (/admin/mail-accounts) — MariaDB mailserver DB (not root; use dedicated user on VPS)
# MAIL_DB_HOST=127.0.0.1
# MAIL_DB_PORT=3306
# MAIL_DB_DATABASE=mailserver
# MAIL_DB_USERNAME=mailuser
# MAIL_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Play — My Gig Guide Android app (footer + home link on www)
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=za.co.mygigguide.mygigguide_app

# Firebase — same project as the mobile app (Google sign-in on web + API token verify)
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=my-gig-guide-43138
# FIREBASE_AUTH_DOMAIN=my-gig-guide-43138.firebaseapp.com
# FIREBASE_WEB_APP_ID=1:929498924637:web:8d691f0f25d1cd9f72afb4

# Rogues on Radio — live stream (listen page + app WebView)
# ROGUES_STREAM_URL=https://edge.iono.fm/xice/441_medium.aac
# ROGUES_PUBLIC_SITE_URL=https://www.roguesonradio.co.za

# 919 FM tenant (919fm.mygigguide.co.za)
# FM919_STREAM_URL=https://edge.iono.fm/xice/112_medium.aac
# FM919_PUBLIC_SITE_URL=https://919.co.za
# FM919_WHATSAPP_E164=27842212919
# FM919_STATION_EMAILS=studio@919.co.za,manager@919.co.za

# Miggie bridge — poster vision (same Docker service as WhatsApp/n8n on the VPS)
MIGGS_BRIDGE_URL=http://127.0.0.1:8787
MIGGS_BRIDGE_POSTER_SECRET=
# MIGGS_BRIDGE_TIMEOUT=120
# MIGGS_BRIDGE_MAX_POSTER_KB=8192

# Quicket — public events pull (subscriber key from https://developer.quicket.co.za/)
# QUICKET_API_KEY=
# QUICKET_BASE_URL=https://api.quicket.co.za/api/events
# Default for manual pulls without --categories (keep Music=1). Nightly cron uses
# separate --categories=1 / 5 / 30 / 9 jobs — do not merge into this env value.
# Arts & Culture (9) cron at 04:05 SAST; Other (64) is manual one-off for now.
# QUICKET_CATEGORIES=1
# Cron inherits this province allowlist (quote if values have spaces)
# QUICKET_PROVINCES="Gauteng,Western Cape,KwaZulu-Natal,Free State,Eastern Cape"
# QUICKET_OWNER_USER_ID=   # Set to Quicket Import system user ID (run: php artisan db:seed --class=SystemUserSeeder)
# QUICKET_PAGE_SIZE=25
# QUICKET_TIMEOUT=60
# Deprecated Music fallback; prefer config/quicket.php category_slug_map
# QUICKET_MGG_CATEGORY_SLUGS=live-music,quicket

# Bandsintown — partner/artist app_id (see docs/BANDSINTOWN_IMPORT.md)
# BANDSINTOWN_APP_ID=
# BANDSINTOWN_COUNTRIES=ZA
# BANDSINTOWN_CITIES=
# BANDSINTOWN_ARTISTS=
# BANDSINTOWN_OWNER_USER_ID=

# FIXR — organiser feed only (see docs/FIXR_INTEGRATION.md)
# FIXR_API_TOKEN=
# FIXR_EVENTS_URL=
# FIXR_WEBHOOK_BEARER=
# FIXR_OWNER_USER_ID=

# Spotify — repertoire search / import (https://developer.spotify.com/dashboard)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://mygigguide.co.za/spotify/callback
# SPOTIFY_PLAYLIST_IMPORT_LIMIT=100

# Claim notifications — admin email + optional WhatsApp (via Evolution API)
# ARTIST_CLAIM_ADMIN_EMAIL=your@email.co.za
# Evolution API — self-hosted WhatsApp Business. Set all four to activate WhatsApp alerts.
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_INSTANCE=default
# EVOLUTION_API_KEY=
# EVOLUTION_ADMIN_NUMBER=27746609752

# New-event WhatsApp alert — comma-separated user IDs to skip (no alert for their events).
# Add your own user ID and the Quicket Import system user ID so their events are silent.
# Example: EVENT_NOTIFY_EXCLUDE_USER_IDS=1,5   (1 = Dave, 5 = Quicket Import user)
# EVENT_NOTIFY_EXCLUDE_USER_IDS=
